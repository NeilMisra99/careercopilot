{
  "name": "trackflow-monorepo-npm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:workers": "npm run dev --workspace=workers",
    "dev:workers:remote": "npm run dev:remote --workspace=workers",
    "build:web": "npm run build --workspace=web",
    "deploy:workers": "npm run deploy --workspace=workers",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
